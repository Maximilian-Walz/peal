#!/usr/bin/env bash
# peal: the one entry point to Peal's scripts. Commands and hooks run it as
# ${CLAUDE_PLUGIN_ROOT}/bin/peal (the plugin's bin/ is also on the Bash tool's PATH),
# everything outside Claude Code through a project's launcher, .peal/peal.
set -uo pipefail

PEAL_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd) || exit 2
export PEAL_ROOT

# shellcheck source=../lib/common.sh
. "$PEAL_ROOT/lib/common.sh"
# shellcheck source=../lib/frontmatter.sh
. "$PEAL_ROOT/lib/frontmatter.sh"
# shellcheck source=../lib/config.sh
. "$PEAL_ROOT/lib/config.sh"
# shellcheck source=../lib/milestones.sh
. "$PEAL_ROOT/lib/milestones.sh"
# shellcheck source=../lib/session.sh
. "$PEAL_ROOT/lib/session.sh"
# shellcheck source=../lib/task-text.sh
. "$PEAL_ROOT/lib/task-text.sh"
# shellcheck source=../lib/store.sh
. "$PEAL_ROOT/lib/store.sh"
# shellcheck source=../lib/github.sh
. "$PEAL_ROOT/lib/github.sh"
# shellcheck source=../lib/tasks.sh
. "$PEAL_ROOT/lib/tasks.sh"
# shellcheck source=../lib/ideas.sh
. "$PEAL_ROOT/lib/ideas.sh"
# shellcheck source=../lib/githooks.sh
. "$PEAL_ROOT/lib/githooks.sh"
# shellcheck source=../lib/commit.sh
. "$PEAL_ROOT/lib/commit.sh"
# shellcheck source=../lib/git-guard.sh
. "$PEAL_ROOT/lib/git-guard.sh"
# shellcheck source=../lib/claim.sh
. "$PEAL_ROOT/lib/claim.sh"
# shellcheck source=../lib/work.sh
. "$PEAL_ROOT/lib/work.sh"
# shellcheck source=../lib/close.sh
. "$PEAL_ROOT/lib/close.sh"

usage() {
  cat <<'EOF'
usage: peal <command> [args]

  --version, version            print Peal's version
  check                         report what is not valid: the milestone files, and a
                                task file under done/ without an Outcome
  config [KEY]                  print the effective settings, or one of them
  frontmatter check FILE        refuse a frontmatter outside Peal's YAML subset
  frontmatter keys FILE         print its keys
  frontmatter get FILE KEY      print a value, or a list's items one per line
  frontmatter set FILE KEY VALUE
  frontmatter set-list FILE KEY [ITEM...]
  frontmatter unset FILE KEY
  milestones [--json]           one line per milestone: id state order due title, or
                                the board's {"milestone":{...}} lines; the milestone
                                files here, or the storage's milestones
  hook session-start            the SessionStart hook: record where Peal is installed;
                                in a Peal project reap the claims done with (on a new
                                session) and print the orientation
  hook post-tool-use            the PostToolUse hook: the heartbeat and the turn budget
  hook session-end              the SessionEnd hook: autosave a task branch as wip, pushed
  hook stop                     the Stop hook: while a close is in progress, refuse to stop
                                with the Outcome empty or work uncommitted or unpushed
  hook git-guard                the PreToolUse hook on Bash: refuse git calls that work
                                around the git gates (lib/git-guard.sh)

Git gates (lib/githooks.sh):
  hooks install                 Peal's git hooks into this repository's git directory,
                                core.hooksPath pointed there; they chain to the hooks
                                that were in use before
  githook NAME ARGS...          run the gate of git hook NAME (pre-push, commit-msg)
  commit SUBJECT [--body TEXT | --body-file FILE] [PATH...]
                                stage PATHs (or everything), commit, report; refused on
                                the main branch

Tasks live in the storage the setting storage.kind names: files, task files on the main
branch (ids 0042), or issues, the repository's GitHub issues (ids 42).

Tasks, read from the storage and the refs (--fetch: fetch first; --no-pr: do not ask gh
for pull requests, which issues cannot do without):
  list [--fetch] [--no-pr] [--state S[,S...]] [ID...]
                                ID state slug detail, per task
  board [--fetch] [--no-pr]     a JSON line per task, then one per milestone
  overview [--fetch]            the open tasks, grouped by milestone
  read ID                       a task's text, from its branch or the main one

Tasks, written straight into the storage (task texts on stdin; NNNN stands for the
number to come, several texts are separated by lines -----NEXT TASK-----):
  create SLUG                   file a task
  create --part-of ID SLUG...   file the pieces of a split of ID (part-of: ORIGIN,
                                PART1..n for each other)
  create --batch ID SLUG...     file ideas found in task ID
  idea SLUG [--now]             queue an idea on a task branch, else (or --now) file it
  ideas [--flush]               the queued ideas; --flush files them
  revise ID --reason R [--dry-run]
                                rewrite an unclaimed task's text
  retire ID --reason R          move an unclaimed task to done, R as its Outcome (an
                                issue: closed as not planned, R as a comment)
  set-milestone ID [M]          set an unclaimed task's milestone, or remove it
  comment ID TEXT               add a dated line to an unclaimed task's Notes (an
                                issue's comment, claimed or not)
  finish ID                     on the task's branch: its file from doing/ to done/,
                                staged; for an issue, what its pull request must say

Claims, each task in a worktree of its own under the worktrees setting (an issue's is
issue-N on branch issue/N, labelled "in progress", as Belfry claims one):
  offer POOL [--top N]          CANDIDATE <id> <bucket> <title> for the best N (3) free
                                tasks, MORE <bucket> <count> for those left; POOL is a
                                comma list of milestone ids, current and unassigned
  claim ID [--print-path]       claim a free task, or resume its parked claim; a task
                                claimed here already prints its worktree again
  claim --next [POOL] [--print-path]
                                claim the best free task of POOL (current,unassigned)
  release ID                    remove a landed claim's worktree and branch, its tip kept
                                under refs/reaped/; refused while anything would be lost

/peal:work's steps (lib/work.sh):
  work [ID | POOL]              in a task's worktree: TASK <id> <file>, PLAN required,
                                agreed or skipped, MODEL <role> <model> per subagent;
                                elsewhere claim ID (CLAIMED <id> <path>) or offer POOL
  brief ROLE                    what the planner, implementer or reviewer of this
                                worktree's task needs of the project, for its prompt
  record ID plan|notes          the task's text on stdin recorded on this worktree's
                                claim: the plan the human agreed, or their answers

/peal:close's steps (lib/close.sh), in the task's worktree:
  close begin                   declare the close (the Stop hook holds the session to
                                it); notes, where the Outcome goes, the diff, Done when
  close finish --summary TEXT [--section TITLE TEXT]...
                                the close checks, the queued ideas filed, the task moved
                                to done, committed, pushed, the pull request opened; the
                                -file forms (--summary-file FILE, --section-file TITLE
                                FILE) read the text from a file
  close body --summary TEXT [--section TITLE TEXT]...
                                the pull request's body finish would open it with
  close abort REASON            call the close off, REASON logged
  close verify                  one verdict: READY (0), WAIT:<why> (3), BLOCKED:<why> (1)
  close wait                    verify until not WAIT, or the budget is spent
                                (PEAL_CLOSE_WAIT_BUDGET, 540 s; PEAL_CLOSE_WAIT_INTERVAL, 20)
EOF
}

peal_version() {
  sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$PEAL_ROOT/.claude-plugin/plugin.json"
}

# need N ARGS...: refuse a call with fewer than N arguments after the subcommand.
need() {
  local count=$1
  shift
  if [ $# -lt "$count" ]; then
    usage >&2
    exit 2
  fi
}

cmd_frontmatter() {
  need 2 "$@"
  local sub=$1
  shift
  case $sub in
    check) need 1 "$@"; peal_fm_check "$1" ;;
    keys) need 1 "$@"; peal_fm_keys "$1" ;;
    get) need 2 "$@"; peal_fm_get "$1" "$2" ;;
    set) need 3 "$@"; peal_fm_set "$1" "$2" "$3" ;;
    set-list) need 2 "$@"; peal_fm_set_list "$@" ;;
    unset) need 2 "$@"; peal_fm_unset "$1" "$2" ;;
    *) usage >&2; exit 2 ;;
  esac
}

cmd_config() {
  peal_config_load || exit 2
  if [ $# -eq 0 ]; then
    peal_config_print
  else
    peal_config_get "$1"
  fi
}

cmd_check() {
  local status=0
  [ $# -eq 0 ] || { usage >&2; exit 2; }
  peal_ms_load || status=2
  peal_check_outcomes || status=2
  exit $status
}

# ms_load -> PEAL_MILESTONES: the milestone files of this work tree, or for another
# storage the milestones it holds.
ms_load() {
  peal_config_load || exit 2
  if [ "$(peal_config_get storage.kind)" = files ]; then
    peal_ms_load || exit 2
  else
    peal_store_load || exit 2
    PEAL_MILESTONES=$(peal_store_milestones) || exit 2
  fi
}

cmd_milestones() {
  case ${1-} in
    "") ms_load; peal_ms_print ;;
    --json) ms_load; peal_ms_json ;;
    *) usage >&2; exit 2 ;;
  esac
}

cmd_hook() {
  need 1 "$@"
  case $1 in
    session-start)
      peal_record_root "${CLAUDE_PROJECT_DIR:-$PWD}"
      peal_hook_read
      peal_session_start
      ;;
    post-tool-use) peal_hook_read; peal_turn_budget || exit $? ;;
    session-end) peal_hook_read; peal_session_end ;;
    stop) peal_hook_read; peal_close_stop || exit $? ;;
    git-guard) peal_git_guard ;;
    *) usage >&2; exit 2 ;;
  esac
}

# with_store COMMAND ARGS... -> COMMAND run with the configured storage loaded.
with_store() {
  peal_store_load || exit 2
  "$@"
}

# reason_args VERB ARGS... -> PEAL_ID, PEAL_REASON and PEAL_DRY from "ID --reason R
# [--dry-run]"; exits 2 on anything else.
reason_args() {
  local verb=$1
  shift
  PEAL_ID=${1-} PEAL_REASON="" PEAL_DRY=""
  [ $# -ge 1 ] && shift
  while [ $# -gt 0 ]; do
    case $1 in
      --reason) [ $# -ge 2 ] || { peal_err "$verb: --reason needs a reason"; exit 2; }; PEAL_REASON=$2; shift ;;
      --dry-run) [ "$verb" = revise ] || { usage >&2; exit 2; }; PEAL_DRY=--dry-run ;;
      *) peal_err "$verb: unknown argument $1"; exit 2 ;;
    esac
    shift
  done
  if [ -z "$PEAL_ID" ] || [ -z "$PEAL_REASON" ]; then
    peal_err "$verb: ID --reason R"
    exit 2
  fi
}

cmd_create() {
  need 1 "$@"
  case $1 in
    --part-of) need 3 "$@"; peal_store_create split "$2" "${@:3}" ;;
    --batch) need 3 "$@"; peal_store_create batch "$2" "${@:3}" ;;
    -*) usage >&2; exit 2 ;;
    *) [ $# -eq 1 ] || { usage >&2; exit 2; }; peal_store_create plain "" "$1" ;;
  esac
}

main() {
  if [ $# -eq 0 ]; then
    usage >&2
    exit 2
  fi
  local cmd=$1
  shift
  case $cmd in
    --version | version) peal_version ;;
    -h | --help | help) usage ;;
    check) cmd_check "$@" ;;
    config) cmd_config "$@" ;;
    frontmatter) cmd_frontmatter "$@" ;;
    hook) cmd_hook "$@" ;;
    hooks) [ "$*" = install ] || { usage >&2; exit 2; }; peal_hooks_install ;;
    githook) need 1 "$@"; peal_githook "$@" ;;
    commit) peal_config_load || exit 2; peal_commit "$@" ;;
    milestones) cmd_milestones "$@" ;;
    list) with_store peal_list "$@" ;;
    board) with_store peal_board "$@" ;;
    overview) with_store peal_overview "$@" ;;
    read) need 1 "$@"; with_store peal_store_read "$1" ;;
    create) with_store cmd_create "$@" ;;
    idea) need 1 "$@"; with_store peal_idea "$@" ;;
    ideas) with_store peal_ideas "$@" ;;
    revise) reason_args revise "$@"; with_store peal_store_edit "$PEAL_ID" "$PEAL_REASON" "$PEAL_DRY" ;;
    retire) reason_args retire "$@"; with_store peal_store_finish "$PEAL_ID" retired "$PEAL_REASON" ;;
    finish) [ $# -eq 1 ] || { usage >&2; exit 2; }; with_store peal_store_finish "$1" "done" ;;
    set-milestone) need 1 "$@"; with_store peal_store_set_milestone "$@" ;;
    offer) with_store peal_offer "$@" ;;
    claim) with_store peal_claim "$@" ;;
    release) with_store peal_release "$@" ;;
    work) with_store peal_work "$@" ;;
    brief) with_store peal_brief "$@" ;;
    record) with_store peal_record "$@" ;;
    close)
      # Verify and wait read the branch and GitHub only, and answer anywhere with a verdict.
      case ${1-} in
        verify | wait) peal_close "$@" ;;
        *) with_store peal_close "$@" ;;
      esac
      ;;
    comment) [ $# -eq 2 ] || { usage >&2; exit 2; }; with_store peal_store_comment "$1" "$2" ;;
    *)
      peal_err "unknown command '$cmd'"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
