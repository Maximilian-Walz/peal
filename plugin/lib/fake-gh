#!/usr/bin/env bash
# shellcheck disable=SC2016 # jq's $variables, not the shell's
# A fake gh for the harnesses of the issues storage and the close: `gh api` over a
# repository held as JSON files in $FAKE_GH (issues.json, milestones.json, pulls.json,
# comments.json, checks.json, statuses.json, runs.json, jobs.json, releases.json), each
# an array of objects shaped like GitHub's REST responses (the fields Peal reads; a check
# or status also names its commit, sha; a job its run, run_id; a release is {tag, title,
# notes, url}), $FAKE_GH/logs/<job id>, a job's log, and $FAKE_GH/workflows, how many
# Actions workflows there are (1). --jq
# is applied with jq, as gh applies its own. A pull request's merge (PUT pulls/N/merge,
# a squash) and a branch's deletion (DELETE git/refs/heads/B) act on the bare repository
# $FAKE_GH/remote; `gh api graphql` knows the mutation enablePullRequestAutoMerge, refused
# while $FAKE_GH/no-auto-merge exists. A pull request opens unmergeable while
# $FAKE_GH/unmergeable exists. $FAKE_GH/checks-pending, when it exists, holds N: the next
# N reads of a commit's check runs find one still running, every later one a completed
# run, failed while $FAKE_GH/checks-fail exists. Every call is appended to $FAKE_GH/log as
# "METHOD PATH"; $FAKE_GH/fail, when it exists, holds a pattern: a call whose
# "METHOD PATH" matches it fails, but for the first N such calls when $FAKE_GH/fail-after
# holds N.
#
#   gh api [-X|--method M] [--paginate] [--input FILE] [--jq|-q EXPR] [-H H] PATH
#   gh release view TAG -R REPO [--json FIELDS] [--jq EXPR]
#   gh release create TAG -R REPO [--verify-tag] [--title T] --notes-file FILE
#   gh release edit TAG -R REPO [--title T] --notes-file FILE
#
# A release call is logged as "RELEASE <verb> <tag>".
# Only the endpoints Peal calls; anything else fails loudly, so a new call cannot pass
# the harness unseen.
set -uo pipefail

die() {
  printf 'fake gh: %s\n' "$*" >&2
  exit 1
}

[ -n "${FAKE_GH:-}" ] || die "FAKE_GH is not set"
for f in issues milestones pulls comments checks statuses runs jobs releases; do
  [ -f "$FAKE_GH/$f.json" ] || printf '[]\n' >"$FAKE_GH/$f.json"
done

if [ "${1-}" = release ]; then
  verb=${2-} tag=${3-} repo="" title="" notes="" jq_expr=""
  shift 3 || die "gh release $verb: no tag"
  while [ $# -gt 0 ]; do
    case $1 in
      -R | --repo) repo=$2; shift ;;
      --title) title=$2; shift ;;
      --notes-file) notes=$(cat "$2") || die "no notes file $2"; shift ;;
      --json) shift ;;
      -q | --jq) jq_expr=$2; shift ;;
      --verify-tag) ;;
      *) die "gh release: unknown option $1" ;;
    esac
    shift
  done
  [ -n "$repo" ] || die "gh release: no -R"
  printf 'RELEASE %s %s\n' "$verb" "$tag" >>"$FAKE_GH/log"
  if [ -s "$FAKE_GH/fail" ] && [[ "RELEASE $verb $tag" == $(cat "$FAKE_GH/fail") ]]; then
    printf 'HTTP 502: failing on purpose (release %s %s)\n' "$verb" "$tag" >&2
    exit 1
  fi
  url="https://github.com/$repo/releases/tag/$tag"
  exists=$(jq --arg t "$tag" 'any(.[]; .tag == $t)' "$FAKE_GH/releases.json")
  file=$FAKE_GH/releases.json
  case $verb in
    view)
      [ "$exists" = true ] || { echo "release not found" >&2; exit 1; }
      jq -c --arg t "$tag" '.[] | select(.tag == $t) | {url}' "$file" | if [ -n "$jq_expr" ]; then jq -r "$jq_expr"; else cat; fi
      ;;
    create)
      [ "$exists" = false ] || { echo "a release with the same tag name already exists: $tag" >&2; exit 1; }
      jq --arg t "$tag" --arg ti "$title" --arg n "$notes" --arg u "$url" '. + [{tag: $t, title: $ti, notes: $n, url: $u}]' \
        "$file" >"$file.new" && mv "$file.new" "$file"
      echo "$url"
      ;;
    edit)
      [ "$exists" = true ] || { echo "release not found" >&2; exit 1; }
      jq --arg t "$tag" --arg ti "$title" --arg n "$notes" 'map(if .tag == $t then . + {title: $ti, notes: $n} else . end)' \
        "$file" >"$file.new" && mv "$file.new" "$file"
      echo "$url"
      ;;
    *) die "gh release $verb is not faked" ;;
  esac
  exit 0
fi

[ "${1-}" = api ] || die "only gh api and gh release are faked, not: gh $*"
shift

method=GET jq_expr="" input="" path="" fields=()
while [ $# -gt 0 ]; do
  case $1 in
    -X | --method) method=$2; shift ;;
    -f | -F | --field | --raw-field) fields+=("$2"); shift ;;
    --paginate) ;;
    --input) input=$2; shift ;;
    -q | --jq) jq_expr=$2; shift ;;
    -H | --header) shift ;;
    -*) die "unknown option $1" ;;
    *) path=$1 ;;
  esac
  shift
done
[ -n "$path" ] || die "no path"
[ "$path" != graphql ] || method=POST
printf '%s %s\n' "$method" "$path" >>"$FAKE_GH/log"
if [ -s "$FAKE_GH/fail" ] && [[ "$method $path" == $(cat "$FAKE_GH/fail") ]]; then
  after=$(cat "$FAKE_GH/fail-after" 2>/dev/null || echo 0)
  if [ "${after:-0}" -gt 0 ]; then
    echo $((after - 1)) >"$FAKE_GH/fail-after"
  else
    printf 'gh: HTTP 502: failing on purpose (%s %s)\n' "$method" "$path" >&2
    exit 1
  fi
fi

body='{}'
if [ -n "$input" ]; then
  if [ "$input" = - ]; then body=$(cat); else body=$(cat "$input"); fi
fi

# query NAME -> the query parameter NAME of the path, %-decoded; empty if absent.
query() {
  local q=${path#*\?} pair v
  [ "$q" != "$path" ] || return 0
  local IFS='&'
  for pair in $q; do
    if [ "${pair%%=*}" = "$1" ]; then
      v=${pair#*=}
      v=${v//+/ }
      printf '%b' "${v//%/\\x}"
      return 0
    fi
  done
}

# save FILE FILTER [ARGS...] -> FILE rewritten by the jq FILTER.
save() {
  local file=$FAKE_GH/$1.json filter=$2
  shift 2
  jq "$@" "$filter" "$file" >"$file.new" && mv "$file.new" "$file"
}

# out JSON -> the response, through --jq when given.
out() {
  if [ -n "$jq_expr" ]; then
    printf '%s\n' "$1" | jq -r "$jq_expr"
  else
    printf '%s\n' "$1"
  fi
}

# field NAME -> the value of the -f field NAME.
field() {
  local f
  for f in ${fields[@]+"${fields[@]}"}; do
    [ "${f%%=*}" != "$1" ] || { printf '%s\n' "${f#*=}"; return 0; }
  done
}

if [ "$path" = graphql ]; then
  case $(field query) in
    *enablePullRequestAutoMerge*)
      if [ -e "$FAKE_GH/no-auto-merge" ]; then
        printf 'GraphQL: Auto merge is not allowed for this repository (enablePullRequestAutoMerge)\n' >&2
        exit 1
      fi
      id=$(field id)
      jq -e --arg id "$id" 'any(.[]; .node_id == $id and .state == "open")' "$FAKE_GH/pulls.json" >/dev/null \
        || { printf 'GraphQL: Could not resolve to a node with the global id of %s\n' "$id" >&2; exit 1; }
      save pulls 'map(if .node_id == $id then . + {auto_merge: {merge_method: "squash"}} else . end)' --arg id "$id"
      out '{"data":{"enablePullRequestAutoMerge":{"clientMutationId":null}}}'
      ;;
    *) die "graphql: only enablePullRequestAutoMerge is faked" ;;
  esac
  exit 0
fi

route=${path%%\?*}
repo_re='^repos/([^/]+/[^/]+)/(.*)$'
[[ "$route" =~ $repo_re ]] || die "unknown path $path"
repo=${BASH_REMATCH[1]}
rest=${BASH_REMATCH[2]}
url="https://github.com/$repo"

case "$method $rest" in
  "GET issues")
    state=$(query state) labels=$(query labels) per=$(query per_page)
    out "$(jq -c --arg s "${state:-open}" --arg l "$labels" --arg per "$per" '
      map(select(($s == "all" or .state == $s)
        and ($l == "" or ([.labels[].name] | index([$l]) != null))))
      | sort_by(-.number)
      | if $per == "" then . else .[0:($per | tonumber)] end' "$FAKE_GH/issues.json")"
    ;;
  "POST issues")
    n=$(jq -s '[.[0][].number, .[1][].number] | max // 0 | . + 1' "$FAKE_GH/issues.json" "$FAKE_GH/pulls.json")
    save issues '. + [$in + {number: $n, state: "open", state_reason: null,
        html_url: ($url + "/issues/" + ($n | tostring)), author_association: "OWNER",
        labels: [($in.labels // [])[] | {name: .}],
        milestone: (if $in.milestone then ($ms[0][] | select(.number == $in.milestone) | {number, title}) else null end)}]' \
      --argjson in "$body" --argjson n "$n" --arg url "$url" --slurpfile ms "$FAKE_GH/milestones.json"
    out "$(jq -c --argjson n "$n" '.[] | select(.number == $n)' "$FAKE_GH/issues.json")"
    ;;
  "GET milestones") out "$(cat "$FAKE_GH/milestones.json")" ;;
  "GET milestones/"* | "PATCH milestones/"*)
    n=${rest#milestones/}
    [[ "$n" =~ ^[0-9]+$ ]] || die "unknown path $path"
    jq -e --argjson n "$n" 'any(.[]; .number == $n)' "$FAKE_GH/milestones.json" >/dev/null \
      || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
    [ "$method" = GET ] || save milestones 'map(if .number == $n then . + $in else . end)' --argjson in "$body" --argjson n "$n"
    out "$(jq -c --argjson n "$n" '.[] | select(.number == $n)' "$FAKE_GH/milestones.json")"
    ;;
  "GET pulls")
    state=$(query state) head=$(query head)
    out "$(jq -c --arg s "${state:-open}" --arg h "${head#*:}" '
      map(select(($s == "all" or .state == $s) and ($h == "" or .head.ref == $h))) | sort_by(-.number)' "$FAKE_GH/pulls.json")"
    ;;
  "POST pulls")
    n=$(jq -s '[.[0][].number, .[1][].number] | max // 0 | . + 1' "$FAKE_GH/issues.json" "$FAKE_GH/pulls.json")
    jq -e --arg h "$(jq -r .head <<<"$body")" 'any(.[]; .state == "open" and .head.ref == $h) | not' \
      "$FAKE_GH/pulls.json" >/dev/null || { printf 'gh: A pull request already exists (HTTP 422)\n' >&2; exit 1; }
    unmergeable=false
    [ ! -e "$FAKE_GH/unmergeable" ] || unmergeable=true
    save pulls '. + [{number: $n, node_id: ("PR_" + ($n | tostring)), title: $in.title, body: $in.body, state: "open", draft: false,
        merged: false, mergeable: ($unm | not), author_association: "OWNER",
        html_url: ($url + "/pull/" + ($n | tostring)),
        head: {ref: $in.head, repo: {full_name: $repo}}, base: {ref: $in.base, repo: {full_name: $repo}}}]' \
      --argjson in "$body" --argjson n "$n" --arg url "$url" --arg repo "$repo" --argjson unm "$unmergeable"
    out "$(jq -c --argjson n "$n" '.[] | select(.number == $n)' "$FAKE_GH/pulls.json")"
    ;;
  "PUT pulls/"*/merge)
    n=${rest#pulls/} n=${n%/merge}
    remote=$FAKE_GH/remote
    [ -d "$remote" ] || die "PUT $path: no \$FAKE_GH/remote"
    jq -e --argjson n "$n" 'any(.[]; .number == $n and .state == "open")' "$FAKE_GH/pulls.json" >/dev/null \
      || { printf 'gh: Pull Request is not mergeable (HTTP 405)\n' >&2; exit 1; }
    IFS="$(printf '\t')" read -r head base title < <(jq -r --argjson n "$n" '.[] | select(.number == $n) | [.head.ref, .base.ref, .title] | @tsv' "$FAKE_GH/pulls.json")
    h=$(git -C "$remote" rev-parse -q --verify "refs/heads/$head") || { printf 'gh: Head branch is gone (HTTP 422)\n' >&2; exit 1; }
    b=$(git -C "$remote" rev-parse -q --verify "refs/heads/$base") || die "no base $base"
    mb=$(git -C "$remote" merge-base "$h" "$b")
    index=$(mktemp) && rm -f "$index"
    if ! GIT_INDEX_FILE=$index git -C "$remote" read-tree -m -i --aggressive "$mb" "$b" "$h" 2>/dev/null \
        || ! tree=$(GIT_INDEX_FILE=$index git -C "$remote" write-tree 2>/dev/null); then
      rm -f "$index"
      printf 'gh: Pull Request is not mergeable (HTTP 405)\n' >&2
      exit 1
    fi
    rm -f "$index"
    if ! c=$(git -C "$remote" commit-tree "$tree" -p "$b" -m "$title (#$n)") \
        || ! git -C "$remote" update-ref "refs/heads/$base" "$c" "$b"; then
      die "the squash onto $base failed"
    fi
    save pulls 'map(if .number == $n then . + {state: "closed", merged: true} else . end)' --argjson n "$n"
    out "{\"sha\": \"$c\", \"merged\": true}"
    ;;
  "DELETE git/refs/heads/"*)
    remote=$FAKE_GH/remote
    [ -d "$remote" ] || die "DELETE $path: no \$FAKE_GH/remote"
    git -C "$remote" update-ref -d "refs/${rest#git/refs/}" 2>/dev/null \
      || { printf 'gh: Reference does not exist (HTTP 422)\n' >&2; exit 1; }
    ;;
  "GET pulls/"* | "PATCH pulls/"*)
    n=${rest#pulls/}
    [[ "$n" =~ ^[0-9]+$ ]] || die "unknown path $path"
    jq -e --argjson n "$n" 'any(.[]; .number == $n)' "$FAKE_GH/pulls.json" >/dev/null \
      || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
    [ "$method" = GET ] || save pulls 'map(if .number == $n then . + $in else . end)' --argjson in "$body" --argjson n "$n"
    out "$(jq -c --argjson n "$n" '.[] | select(.number == $n) | {merged: false, mergeable: null} + .' "$FAKE_GH/pulls.json")"
    ;;
  "GET commits/"*/check-runs)
    sha=${rest#commits/} sha=${sha%/check-runs}
    if [ -f "$FAKE_GH/checks-pending" ]; then
      left=$(cat "$FAKE_GH/checks-pending")
      if [ "${left:-0}" -gt 0 ]; then
        echo $((left - 1)) >"$FAKE_GH/checks-pending"
        run='{"status": "in_progress", "conclusion": null}'
      elif [ -e "$FAKE_GH/checks-fail" ]; then
        run='{"status": "completed", "conclusion": "failure"}'
      else
        run='{"status": "completed", "conclusion": "success"}'
      fi
      out "{\"total_count\": 1, \"check_runs\": [$run]}"
    else
      out "$(jq -c --arg sha "$sha" 'map(select(.sha == $sha)) | {total_count: length, check_runs: .}' "$FAKE_GH/checks.json")"
    fi
    ;;
  "GET commits/"*/status)
    sha=${rest#commits/} sha=${sha%/status}
    out "$(jq -c --arg sha "$sha" 'map(select(.sha == $sha)) | {statuses: .}' "$FAKE_GH/statuses.json")"
    ;;
  "GET actions/runs")
    sha=$(query head_sha)
    out "$(jq -c --arg sha "$sha" '{workflow_runs: map(select($sha == "" or .head_sha == $sha))}' "$FAKE_GH/runs.json")"
    ;;
  "GET actions/runs/"*/jobs)
    n=${rest#actions/runs/} n=${n%/jobs}
    out "$(jq -c --argjson n "$n" '{jobs: map(select(.run_id == $n))}' "$FAKE_GH/jobs.json")"
    ;;
  "GET actions/jobs/"*/logs)
    n=${rest#actions/jobs/} n=${n%/logs}
    [ -f "$FAKE_GH/logs/$n" ] || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
    cat "$FAKE_GH/logs/$n"
    ;;
  "GET actions/workflows") out "{\"total_count\": $(cat "$FAKE_GH/workflows" 2>/dev/null || echo 1)}" ;;
  *)
    issue_re='^issues/([0-9]+)(/.*)?$'
    [[ "$rest" =~ $issue_re ]] || die "unknown path $path"
    n=${BASH_REMATCH[1]} sub=${BASH_REMATCH[2]}
    jq -e --argjson n "$n" 'any(.[]; .number == $n)' "$FAKE_GH/issues.json" >/dev/null \
      || { printf 'gh: Not Found (HTTP 404)\n' >&2; exit 1; }
    case "$method $sub" in
      "GET ")
        out "$(jq -c --argjson n "$n" '.[] | select(.number == $n)' "$FAKE_GH/issues.json")"
        ;;
      "PATCH ")
        save issues 'map(if .number == $n then
            . + ($in | del(.milestone)) + (if $in | has("milestone") then
              {milestone: (if $in.milestone then ($ms[0][] | select(.number == $in.milestone) | {number, title}) else null end)}
              else {} end)
          else . end)' --argjson in "$body" --argjson n "$n" --slurpfile ms "$FAKE_GH/milestones.json"
        out "$(jq -c --argjson n "$n" '.[] | select(.number == $n)' "$FAKE_GH/issues.json")"
        ;;
      "POST /labels")
        save issues 'map(if .number == $n then .labels += [$in.labels[] as $l | select([.labels[].name] | index([$l]) | not) | {name: $l}] else . end)' \
          --argjson in "$body" --argjson n "$n"
        out "$(jq -c --argjson n "$n" '.[] | select(.number == $n) | .labels' "$FAKE_GH/issues.json")"
        ;;
      "DELETE /labels/"*)
        name=${sub#/labels/}
        name=$(printf '%b' "${name//%/\\x}")
        jq -e --argjson n "$n" --arg l "$name" 'any(.[]; .number == $n and any(.labels[]; .name == $l))' \
          "$FAKE_GH/issues.json" >/dev/null || { printf 'gh: Label does not exist (HTTP 404)\n' >&2; exit 1; }
        save issues 'map(if .number == $n then .labels |= map(select(.name != $l)) else . end)' --argjson n "$n" --arg l "$name"
        out "[]"
        ;;
      "POST /comments")
        save comments '. + [{issue: $n, body: $in.body, user: {login: "peal"}, author_association: "OWNER"}]' \
          --argjson in "$body" --argjson n "$n"
        out '{}'
        ;;
      "GET /comments")
        out "$(jq -c --argjson n "$n" 'map(select(.issue == $n))' "$FAKE_GH/comments.json")"
        ;;
      *) die "unknown path $method $path" ;;
    esac
    ;;
esac
